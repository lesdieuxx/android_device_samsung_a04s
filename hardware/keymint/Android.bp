package {
    default_applicable_licenses: [
        "Android-Apache-2.0",
    ],
}

vintf_fragment {
    name: "android.hardware.security.keymint-service.samsung.xml",
    src: "android.hardware.security.keymint-service.samsung.xml",
    vendor: true,
}

vintf_fragment {
    name: "android.hardware.security.sharedsecret-service.samsung.xml",
    src: "android.hardware.security.sharedsecret-service.samsung.xml",
    vendor: true,
}

vintf_fragment {
    name: "android.hardware.security.secureclock-service.samsung.xml",
    src: "android.hardware.security.secureclock-service.samsung.xml",
    vendor: true,
}

cc_binary {
    name: "android.hardware.security.keymint-service.samsung",
    relative_install_path: "hw",
    init_rc: ["android.hardware.security.keymint-service.samsung.rc"],
    vendor: true,
    cflags: [
        "-Wall",
        "-Wextra",
    ],
    shared_libs: [
        "android.hardware.security.keymint-V1-ndk",
        "android.hardware.security.rkp-V1-ndk",
        "android.hardware.security.sharedsecret-V1-ndk",
        "android.hardware.security.secureclock-V1-ndk",
        "libbase",
        "libbinder_ndk",
        "libskeymint10device",
    ],
    srcs: [
        "service.cpp",
    ],
    local_include_dirs: [
        "include",
    ],
    required: [
        "android.hardware.hardware_keystore.xml",
    ],
    vintf_fragment_modules: [
        "android.hardware.security.keymint-service.samsung.xml",
        "android.hardware.security.sharedsecret-service.samsung.xml",
        "android.hardware.security.secureclock-service.samsung.xml",
    ],
}
